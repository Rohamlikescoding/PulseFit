# Server-side Workout API Key (Never expose to client or use NEXT_PUBLIC_)
WORKOUT_API_KEY=
WORKOUTAPI_KEY=
EXERCISE_API_KEY=

# --- Auth ---
# Secret used to sign session cookies. REQUIRED in production (use a long random string:
#   openssl rand -base64 32). A dev-only fallback is used when NODE_ENV !== production.
AUTH_SECRET=
# Coach login. In development these default to admin / admin123 if left empty.
# In production there is NO default: leave empty and nobody can log in as coach.
COACH_DEV_USERNAME=
COACH_DEV_PASSWORD=
