# این فایل را به .env کپی کنید و مقادیر را پر کنید.
# ساخت کلید جدید:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
# اگر خالی باشد SQLite استفاده می‌شود:
# PostgreSQL in WSL (scripts/start_services.ps1) runs on port 5434:
# DATABASE_URL=postgres://coach:password@127.0.0.1:5434/coach
# TIME_ZONE=Asia/Tehran

# پیامک: در توسعه Console، در production Kavenegar
SMS_BACKEND=accounts.sms.console.ConsoleSMSBackend
# SMS_BACKEND=accounts.sms.kavenegar.KavenegarSMSBackend
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=verify
# CELERY_TASK_ALWAYS_EAGER=False
