# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WORKOUT_API_KEY: API key for WorkoutAPI (https://docs.workoutapi.com/api/get-all-exercises)
# Configure this in your environment or .env.local to load live exercises and GIFs from WorkoutAPI.
WORKOUT_API_KEY=""

# BACKEND_API: Base URL of your backend REST or GraphQL API
# When connecting a custom backend, set this to your server origin (e.g., http://localhost:5000/api or https://api.yourdomain.com/api)
VITE_API_BASE_URL="http://localhost:5000/api"

